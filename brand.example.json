{
  "$comment": "Copy to brand.json and edit. Every colour, font and footer in the pipeline reads from here. Nothing brand-specific is hardcoded in the builders.",
  "name": "Your Name",
  "font": {
    "family": "Space Grotesk",
    "weights": "400;500;600;700",
    "source": "google"
  },
  "themes": {
    "light": {
      "canvas": "#F8FBFF",
      "surface": "#FFFFFF",
      "border": "#E5E5E5",
      "text": "#0C0C0C",
      "muted": "#6B6B6B",
      "faint": "#A0A0A0",
      "accent": "#047857",
      "onAccent": "#FFFFFF"
    },
    "dark": {
      "canvas": "#0F0F0F",
      "surface": "rgba(255,255,255,0.03)",
      "border": "rgba(255,255,255,0.09)",
      "text": "#FFFFFF",
      "muted": "#A0A0A0",
      "faint": "#554E48",
      "accent": "#03D08C",
      "onAccent": "#0F0F0F"
    }
  },
  "footer": {
    "name": "Your Name",
    "role": "",
    "avatar": null,
    "tagline": {
      "accent": "YOUR",
      "rest": "tagline here"
    },
    "logo": null,
    "$avatarNote": "Point at your own image (jpg/png), relative to this file. null renders a text-only footer."
  },
  "rules": {
    "banDashes": true,
    "extraPaletteHex": [],
    "defaultTheme": "dark"
  }
}
